          { "value": "award", "label": "Award" }, { "value": "truck", "label": "Truck" }, { "value": "leaf", "label": "Leaf" }, { "value": "heart", "label": "Heart" }
        ] },
        { "type": "text", "id": "label_2", "label": "Label 2", "default": "14 dagars ångerrätt" },
        { "type": "select", "id": "icon_3", "label": "Icon 3", "default": "truck", "options": [
          { "value": "none", "label": "None" }, { "value": "lock", "label": "Lock" }, { "value": "shield", "label": "Shield" }, { "value": "return", "label": "Returns" },
          { "value": "award", "label": "Award" }, { "value": "truck", "label": "Truck" }, { "value": "leaf", "label": "Leaf" }, { "value": "heart", "label": "Heart" }
        ] },
        { "type": "text", "id": "label_3", "label": "Label 3", "default": "Snabb leverans" }
      ]
    },
    {
