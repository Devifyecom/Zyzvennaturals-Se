        { "type": "text", "id": "off_label", "label": "\"% off\" text", "info": "[percent] is replaced.", "default": "[percent] % rabatt" },
        { "type": "text", "id": "add_label", "label": "Add button", "default": "Lägg till" },
        { "type": "text", "id": "hint_start", "label": "Hint – before first tier", "info": "[count] and [percent] are replaced.", "default": "Välj [count] till för att få [percent] % rabatt" },
        { "type": "text", "id": "hint_next", "label": "Hint – next tier", "default": "Lägg till [count] till för [percent] % rabatt" },
        { "type": "text", "id": "hint_max", "label": "Hint – max tier reached", "default": "Snyggt! Du får [percent] % rabatt" },
        { "type": "text", "id": "discount_label", "label": "Discount label", "info": "Shown in the summary. Use the same name as your Shopify discount so checkout matches.", "default": "Paketrabatt" },
        { "type": "text", "id": "saved_label", "label": "Saved text", "info": "[amount] is replaced.", "default": "Du sparar [amount]" },
        { "type": "text", "id": "button_label", "label": "Add bundle button", "default": "Lägg paketet i varukorgen" },
        { "type": "text", "id": "note", "label": "Small print", "default": "Rabatten dras automatiskt i kassan." }
      ]
