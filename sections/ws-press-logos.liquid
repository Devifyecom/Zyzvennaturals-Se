{%- liquid
  assign s = section.settings
  assign heading_id = 'ws-press-h-' | append: section.id
-%}

{% render 'ws-assets' %}

<section
  class="ws-section ws-press{% if s.grayscale %} ws-press--gray{% endif %} ws-press--d-{{ s.desktop_layout }}"
  style="{% render 'ws-section-style', settings: s %} --ws-logo-h: {{ s.logo_height }}px; --ws-logo-h-m: {{ s.logo_height_mobile }}px; --ws-marquee-duration: {{ s.speed }}s;"
  {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% else %}aria-label="{{ s.aria_label | escape }}"{% endif %}
>
  {%- if s.heading != blank -%}
    <div class="ws-container">
      {% render 'ws-heading', text: s.heading, look: 'label', tag: 'h2', id: heading_id, class: 'ws-press__heading' %}
    </div>
  {%- endif -%}

  {%- capture logos -%}
    {%- for block in section.blocks -%}
      {%- assign b = block.settings -%}
      <li class="ws-press__item" {{ block.shopify_attributes }}>
        {%- if b.link != blank -%}<a href="{{ b.link }}" class="ws-press__link"{% if b.new_tab %} target="_blank" rel="noopener"{% endif %} __TABINDEX__>{%- endif -%}
        {%- if b.logo != blank -%}
          {{
            b.logo
            | image_url: height: 160
            | image_tag:
              height: s.logo_height,
              loading: 'lazy',
              class: 'ws-press__logo',
              alt: b.name
          }}
        {%- else -%}
          <span class="ws-press__name">{{ b.name | escape }}</span>
        {%- endif -%}
        {%- if b.link != blank -%}</a>{%- endif -%}
      </li>
    {%- endfor -%}
  {%- endcapture -%}

  <div class="ws-press__viewport">
    <ul class="ws-press__list" role="list">
      {{ logos | replace: '__TABINDEX__', '' }}
    </ul>
    <ul class="ws-press__list ws-press__list--clone" role="list" aria-hidden="true">
      {{ logos | replace: '__TABINDEX__', 'tabindex="-1"' }}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ws-press__heading { margin-bottom: 24px; }

  .ws-press__viewport {
    display: flex;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .ws-press__list {
    display: flex;
    flex: none;
    align-items: center;
    gap: 44px;
    margin: 0;
    padding: 0 22px;
    list-style: none;
    animation: ws-press-marquee var(--ws-marquee-duration, 30s) linear infinite;
  }

  .ws-press__viewport:hover .ws-press__list,
  .ws-press__viewport:focus-within .ws-press__list { animation-play-state: paused; }

  .ws-press__item { flex: none; display: flex; align-items: center; }

  .ws-press__link { display: inline-flex; color: inherit; }

  .ws-press__logo {
    display: block;
    width: auto;
    height: var(--ws-logo-h-m, 24px);
    max-width: 160px;
    object-fit: contain;
  }

  .ws-press__name {
    font-family: var(--ws-font-heading);
    font-size: calc(var(--ws-logo-h-m, 24px) * 0.9);
    line-height: 1;
    white-space: nowrap;
  }

  .ws-press--gray .ws-press__logo { filter: grayscale(1); opacity: 0.85; }
  .ws-press--gray .ws-press__link:hover .ws-press__logo { filter: none; opacity: 1; }

  @keyframes ws-press-marquee {
    to { transform: translateX(-100%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ws-press__viewport { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .ws-press__list { animation: none; }
    .ws-press__list--clone { display: none; }
  }

  @media screen and (min-width: 990px) {
    .ws-press__logo { height: var(--ws-logo-h, 32px); max-width: 200px; }
    .ws-press__name { font-size: calc(var(--ws-logo-h, 32px) * 0.9); }

    .ws-press--d-static .ws-press__viewport {
      max-width: var(--ws-max-width);
      margin-inline: auto;
      padding-inline: var(--ws-gutter);
      -webkit-mask-image: none;
      mask-image: none;
    }

    .ws-press--d-static .ws-press__list {
      flex: 1 1 auto;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 24px 40px;
      padding: 0;
      animation: none;
    }

    .ws-press--d-static .ws-press__list--clone { display: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WS · Press logos",
  "disabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Optional, e.g. \"Som sett i\"." },
    { "type": "text", "id": "aria_label", "label": "Accessible name (used when heading is empty)", "default": "Som sett i" },
    { "type": "select", "id": "desktop_layout", "label": "Desktop layout", "default": "static", "options": [
      { "value": "static", "label": "Static row" }, { "value": "marquee", "label": "Scrolling marquee" }
    ], "info": "Mobile always scrolls." },
    { "type": "range", "id": "speed", "label": "Marquee duration (lower = faster)", "min": 10, "max": 80, "step": 5, "unit": "s", "default": 30 },
    { "type": "checkbox", "id": "grayscale", "label": "Grayscale logos", "default": true },
    { "type": "range", "id": "logo_height", "label": "Desktop logo height", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "logo_height_mobile", "label": "Mobile logo height", "min": 12, "max": 60, "step": 2, "unit": "px", "default": 22 },
    {"type": "header", "content": "Colours"},
    {"type": "color", "id": "background_color", "label": "Background", "default": "#F3F0EB"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#111111"},
    {"type": "color", "id": "accent_color", "label": "Button background", "default": "#000000"},
    {"type": "color", "id": "accent_text_color", "label": "Button text", "default": "#FFFFFF"},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "container_width", "label": "Content width", "default": "normal", "options": [{"value": "narrow", "label": "Narrow"}, {"value": "normal", "label": "Normal"}, {"value": "full", "label": "Full width"}]},
    {"type": "header", "content": "Spacing – desktop"},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 28},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 28},
    {"type": "header", "content": "Spacing – mobile"},
    {"type": "range", "id": "padding_top_mobile", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20},
    {"type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20}
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "limit": 16,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Transparent PNG or SVG works best." },
        { "type": "text", "id": "name", "label": "Publication name", "info": "Used as alt text, and shown as text if no logo is uploaded.", "default": "Publikation" },
        { "type": "url", "id": "link", "label": "Link to article" },
        { "type": "checkbox", "id": "new_tab", "label": "Open link in new tab", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "WS · Press logos",
      "blocks": [
        { "type": "logo", "settings": { "name": "Vogue" } },
        { "type": "logo", "settings": { "name": "Elle" } },
        { "type": "logo", "settings": { "name": "Expressen" } },
        { "type": "logo", "settings": { "name": "Femina" } },
        { "type": "logo", "settings": { "name": "Hälsa" } },
        { "type": "logo", "settings": { "name": "Amelia" } }
      ]
    }
  ]
}
{% endschema %}
