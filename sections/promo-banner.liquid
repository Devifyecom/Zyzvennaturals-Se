{%- liquid
  assign sid = section.id
-%}

{% style %}
  .promo-banner-{{ sid }} {
    position: relative;
    display: flex;
    align-items: center;
    min-height: {{ section.settings.min_height_mobile }}px;
    padding: {{ section.settings.padding_top | times: 0.6 | round }}px 20px {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    background-color: {{ section.settings.background_color }};
    overflow: hidden;
    isolation: isolate;
  }
  .promo-banner-{{ sid }} .promo-banner__media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .promo-banner-{{ sid }} .promo-banner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .promo-banner-{{ sid }} .promo-banner__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: {{ section.settings.overlay_color }};
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
  .promo-banner-{{ sid }} .promo-banner__inner {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: {{ section.settings.alignment }};
    text-align: {% if section.settings.alignment == 'center' %}center{% elsif section.settings.alignment == 'flex-end' %}right{% else %}left{% endif %};
    color: {{ section.settings.text_color }};
    gap: 16px;
  }
  .promo-banner-{{ sid }} .promo-banner__subheading {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.9;
  }
  .promo-banner-{{ sid }} .promo-banner__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-size: {{ section.settings.heading_size | times: 0.65 | round }}px;
    line-height: 1.15;
    color: inherit;
    max-width: 800px;
  }
  .promo-banner-{{ sid }} .promo-banner__text {
    max-width: 640px;
    font-size: 15px;
    line-height: 1.6;
  }
  .promo-banner-{{ sid }} .promo-banner__text p { margin: 0; }
  .promo-banner-{{ sid }} .promo-banner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
    justify-content: {{ section.settings.alignment }};
    width: 100%;
  }
  .promo-banner-{{ sid }} .promo-banner__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 180px;
    padding: 14px 32px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border: 2px solid;
    border-radius: {{ section.settings.button_radius }}px;
    transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
  }
  .promo-banner-{{ sid }} .promo-banner__btn--1 {
    background-color: {{ section.settings.button_1_bg }};
    color: {{ section.settings.button_1_text }};
    border-color: {{ section.settings.button_1_bg }};
  }
  .promo-banner-{{ sid }} .promo-banner__btn--1:hover {
    background-color: transparent;
    color: {{ section.settings.button_1_bg }};
  }
  .promo-banner-{{ sid }} .promo-banner__btn--2 {
    background-color: transparent;
    color: {{ section.settings.button_2_color }};
    border-color: {{ section.settings.button_2_color }};
  }
  .promo-banner-{{ sid }} .promo-banner__btn--2:hover {
    background-color: {{ section.settings.button_2_color }};
    color: {{ section.settings.button_2_hover_text }};
  }

  @media screen and (max-width: 749px) {
    .promo-banner-{{ sid }} .promo-banner__buttons { flex-direction: column; align-items: stretch; }
    .promo-banner-{{ sid }} .promo-banner__btn { width: 100%; }
  }

  @media screen and (min-width: 750px) {
    .promo-banner-{{ sid }} {
      min-height: {{ section.settings.min_height }}px;
      padding: {{ section.settings.padding_top }}px 40px {{ section.settings.padding_bottom }}px;
    }
    .promo-banner-{{ sid }} .promo-banner__heading {
      font-size: {{ section.settings.heading_size }}px;
    }
    .promo-banner-{{ sid }} .promo-banner__text { font-size: 17px; }
  }
{% endstyle %}

<div class="promo-banner promo-banner-{{ sid }}">
  {%- if section.settings.image != blank -%}
    <div class="promo-banner__media">
      {%- if section.settings.image_mobile != blank -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
          >
          {{
            section.settings.image
            | image_url: width: 2400
            | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: section.settings.image.alt
          }}
        </picture>
      {%- else -%}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag: loading: 'lazy', sizes: '100vw', widths: '750, 1100, 1500, 1920, 2400', alt: section.settings.image.alt
        }}
      {%- endif -%}
    </div>
    <div class="promo-banner__overlay"></div>
  {%- endif -%}

  <div class="promo-banner__inner">
    {%- if section.settings.subheading != blank -%}
      <p class="promo-banner__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="promo-banner__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="promo-banner__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
      <div class="promo-banner__buttons">
        {%- if section.settings.button_1_label != blank -%}
          <a
            class="promo-banner__btn promo-banner__btn--1"
            href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}"
          >
            {{- section.settings.button_1_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a
            class="promo-banner__btn promo-banner__btn--2"
            href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}"
          >
            {{- section.settings.button_2_label | escape -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "class": "section promo-banner-section",
  "settings": [
    { "type": "header", "content": "Media" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile background image (optional)" },
    { "type": "color", "id": "overlay_color", "label": "Overlay color", "default": "#000000" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "default": 30 },
    { "type": "color", "id": "background_color", "label": "Background color (no image)", "default": "#2f4a3a" },

    { "type": "header", "content": "Content" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Naturligt välmående" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upptäck kraften i naturen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Noga utvalda naturliga produkter för inre balans och yttre egenvård.</p>" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "range", "id": "heading_size", "label": "Heading size (desktop)", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 48 },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" }
      ],
      "default": "center"
    },

    { "type": "header", "content": "Button 1" },
    { "type": "text", "id": "button_1_label", "label": "Label", "default": "Shop now" },
    { "type": "url", "id": "button_1_link", "label": "Link" },
    { "type": "color", "id": "button_1_bg", "label": "Background color", "default": "#ffffff" },
    { "type": "color", "id": "button_1_text", "label": "Text color", "default": "#1a1a1a" },

    { "type": "header", "content": "Button 2" },
    { "type": "text", "id": "button_2_label", "label": "Label", "default": "Shop now" },
    { "type": "url", "id": "button_2_link", "label": "Link" },
    { "type": "color", "id": "button_2_color", "label": "Border & text color", "default": "#ffffff" },
    { "type": "color", "id": "button_2_hover_text", "label": "Hover text color", "default": "#1a1a1a" },
    { "type": "range", "id": "button_radius", "label": "Button corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "label": "Minimum height (desktop)", "min": 200, "max": 900, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "min_height_mobile", "label": "Minimum height (mobile)", "min": 200, "max": 900, "step": 20, "unit": "px", "default": 420 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 }
  ],
  "presets": [
    { "name": "Promo banner" }
  ]
}
{% endschema %}
