{%- liquid
  assign s = section.settings
  assign heading_id = 'ws-tiles-h-' | append: section.id
  assign cols = s.columns
-%}

{% render 'ws-assets' %}

<section
  class="ws-section ws-tiles ws-tiles--{{ s.label_style }}"
  style="{% render 'ws-section-style', settings: s %}"
  {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% endif %}
>
  <div class="ws-container">
    {%- if s.eyebrow != blank or s.heading != blank -%}
      <div class="ws-head">
        {%- if s.eyebrow != blank -%}<p class="ws-eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {% render 'ws-heading', text: s.heading, look: s.heading_style, size: 'h2', id: heading_id %}
      </div>
    {%- endif -%}

    <ul
      class="ws-grid ws-tiles__grid{% if s.mobile_layout == 'carousel' %} ws-pgrid__grid--carousel{% endif %}"
      style="--ws-cols: {{ cols }}; --ws-cols-m: 2;"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign col = b.collection
          assign label = b.label
          if label == blank and col != blank
            assign label = col.title
          endif
          assign img = b.image
          if img == blank and col != blank
            assign img = col.featured_image
          endif
          assign url = b.link
          if url == blank and col != blank
            assign url = col.url
          endif
        -%}
        <li class="ws-grid__item" {{ block.shopify_attributes }}>
          <div class="ws-tile">
            <div class="ws-media ws-tile__media" style="--ws-ratio: {{ s.image_ratio }};">
              {%- if img != blank -%}
                {{
                  img
                  | image_url: width: 900
                  | image_tag:
                    widths: '240, 360, 480, 640, 900',
                    sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 50vw',
                    loading: 'lazy',
                    alt: ''
                }}
              {%- else -%}
                {%- assign ph_i = forloop.index0 | modulo: 6 | plus: 1 -%}{{ 'collection-' | append: ph_i | placeholder_svg_tag: 'ws-placeholder' }}
              {%- endif -%}
            </div>
            <h3 class="ws-tile__label">
              {%- if url != blank -%}
                <a href="{{ url }}" class="ws-tile__link">{{ label | default: s.placeholder_label | escape }}</a>
              {%- else -%}
                {{ label | default: s.placeholder_label | escape }}
              {%- endif -%}
            </h3>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ws-tile { position: relative; display: flex; flex-direction: column; }
  .ws-tile__media img { transition: transform 0.8s var(--ws-ease); }
  .ws-tile:hover .ws-tile__media img { transform: scale(1.04); }

  .ws-tile__label {
    margin: 12px 0 0;
    font-family: var(--ws-font-heading);
    font-weight: var(--ws-font-heading-weight);
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.375rem);
    line-height: 1.2;
    text-align: center;
  }

  .ws-tiles--italic .ws-tile__label { font-style: italic; }

  .ws-tiles--uppercase .ws-tile__label {
    font-family: var(--ws-font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ws-tiles--overlay .ws-tile__label {
    position: absolute;
    inset: auto 0 0 0;
    margin: 0;
    padding: 40px 12px 16px;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.45));
    color: #ffffff;
    font-style: italic;
  }

  .ws-tile__link { color: inherit; text-decoration: none; }
  .ws-tile__link::after { content: ''; position: absolute; inset: 0; z-index: 1; }
  .ws-tile:hover .ws-tile__link { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .ws-tile:has(.ws-tile__link:focus-visible) { outline: 2px solid var(--ws-fg); outline-offset: 4px; }
  .ws-tile__link:focus-visible { outline: none; }
{% endstylesheet %}

{% schema %}
{
  "name": "WS · Collection tiles",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Kollektioner" },
    { "type": "select", "id": "heading_style", "label": "Heading style", "default": "label", "options": [
      { "value": "label", "label": "Small uppercase label" }, { "value": "serif", "label": "Large serif" }
    ] },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "grid", "options": [
      { "value": "grid", "label": "2-column grid" }, { "value": "carousel", "label": "Swipe carousel" }
    ] },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "1 / 1", "options": [
      { "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait (4:5)" }, { "value": "3 / 4", "label": "Tall (3:4)" }
    ] },
    { "type": "select", "id": "label_style", "label": "Label style", "default": "italic", "options": [
      { "value": "italic", "label": "Italic serif below image" }, { "value": "serif", "label": "Serif below image" },
      { "value": "uppercase", "label": "Small uppercase below image" }, { "value": "overlay", "label": "Over image" }
    ] },
    { "type": "text", "id": "placeholder_label", "label": "Placeholder label", "default": "Kollektion" },
    {"type": "header", "content": "Colours"},
    {"type": "color", "id": "background_color", "label": "Background", "default": "#F3F0EB"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#111111"},
    {"type": "color", "id": "accent_color", "label": "Button background", "default": "#000000"},
    {"type": "color", "id": "accent_text_color", "label": "Button text", "default": "#FFFFFF"},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "container_width", "label": "Content width", "default": "normal", "options": [{"value": "narrow", "label": "Narrow"}, {"value": "normal", "label": "Normal"}, {"value": "full", "label": "Full width"}]},
    {"type": "header", "content": "Spacing – desktop"},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56},
    {"type": "header", "content": "Spacing – mobile"},
    {"type": "range", "id": "padding_top_mobile", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40},
    {"type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40}
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "limit": 12,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Defaults to the collection image." },
        { "type": "text", "id": "label", "label": "Custom label", "info": "Defaults to the collection title." },
        { "type": "url", "id": "link", "label": "Custom link", "info": "Defaults to the collection." }
      ]
    }
  ],
  "presets": [
    {
      "name": "WS · Collection tiles",
      "blocks": [
        { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
