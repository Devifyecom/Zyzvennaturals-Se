              "type": "custom-liquid",
              "name": "t:names.custom_liquid",
              "settings": {
                "custom_liquid": "<hr>\n\n{% assign current_product = closest.product %}\n\n{% if current_product and current_product.tags != blank %}\n  <ul class=\"product-tags\">\n    {% for tag in current_product.tags %}\n      <li class=\"product-tag\">{{ tag }}</li>\n    {% endfor %}\n  </ul>\n{% endif %}\n\n<style>\n/* Divider */\nhr {\n  border: none;\n  height: 1px;\n  background-color: #f2f2f2;\n  margin: 10px 0;\n}\n\n/* Tags wrapper */\n.product-tags {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center; /* last row center */\n  gap: 6px;\n  padding: 0;\n  margin: 12px auto 10px;\n  list-style: none;\n}\n\n/* Individual tag */\n.product-tag {\n  font-size: 11px;\n  color: #000;\n  background: #D4D4D4;\n  padding: 4px 10px;\n  border-radius: 4px;\n  white-space: nowrap;\n}\n\n/* 📱 Mobile → 2 tags per row */\n@media (max-width: 480px) {\n  .product-tags {\n    max-width: 100px; /* 👈 2 per row */\n  }\n}\n\n/* 📱 Tablet → 3 tags per row, last one centered */\n@media (min-width: 481px) and (max-width: 768px) {\n  .product-tags {\n    max-width: 120px; /* 👈 3 per row */\n  }\n}\n\n/* 💻 Desktop → same as tablet (3 per row) */\n@media (min-width: 769px) {\n  .product-tags {\n    max-width: 300px;\n  }\n}\n</style>"
