{%- doc -%}
  Renders an inline SVG icon from the ws- icon set (1.5px stroke, 24x24, currentColor).

  @param {string} name - Icon name: truck, shield, lock, return, leaf, heart, star, check, plus, minus, close,
    arrow-left, arrow-right, chevron-down, gift, clock, package, chat, sparkle, droplet, bag, globe, award, mail
  @param {string} [class] - Extra class on the svg
  @param {number} [size] - Pixel size (defaults to 24, CSS can override)

  @example
  {% render 'ws-icon', name: 'truck', size: 20 %}
{%- enddoc -%}

{%- liquid
  assign icon_size = size | default: 24
  case name
    when 'truck'
      assign paths = '<path d="M3 6.5h11v9H3z"/><path d="M14 9.5h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.75"/><circle cx="17" cy="17.5" r="1.75"/>'
    when 'shield'
      assign paths = '<path d="M12 3l7.5 3v5.5c0 4.5-3.2 8-7.5 9.5-4.3-1.5-7.5-5-7.5-9.5V6z"/><path d="M8.75 12l2.25 2.25 4.25-4.5"/>'
    when 'lock'
      assign paths = '<rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 018 0v3"/>'
    when 'return'
      assign paths = '<path d="M9 14L4 9l5-5"/><path d="M4 9h10.5a5.5 5.5 0 010 11H11"/>'
    when 'leaf'
      assign paths = '<path d="M5 19C5 10 10 5 20 4c-.5 10-5.5 15-14 15z"/><path d="M5 19l8-8"/>'
    when 'heart'
      assign paths = '<path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0112 7.3a4.3 4.3 0 017.5 2.5C19.5 15.4 12 20 12 20z"/>'
    when 'star'
      assign paths = '<path d="M12 3.5l2.6 5.5 6 .7-4.5 4.1 1.2 6-5.3-3-5.3 3 1.2-6L3.4 9.7l6-.7z"/>'
    when 'check'
      assign paths = '<path d="M5 12.5l4.5 4.5L19 7.5"/>'
    when 'plus'
      assign paths = '<path d="M12 5v14M5 12h14"/>'
    when 'minus'
      assign paths = '<path d="M5 12h14"/>'
    when 'close'
      assign paths = '<path d="M6 6l12 12M18 6L6 18"/>'
    when 'arrow-left'
      assign paths = '<path d="M19 12H5M11 6l-6 6 6 6"/>'
    when 'arrow-right'
      assign paths = '<path d="M5 12h14M13 6l6 6-6 6"/>'
    when 'chevron-down'
      assign paths = '<path d="M6 9l6 6 6-6"/>'
    when 'gift'
      assign paths = '<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M3 9h18M12 9v11M12 9c-1.5-3-5.5-4-5.5-1.5S10 9 12 9zm0 0c1.5-3 5.5-4 5.5-1.5S14 9 12 9z"/>'
    when 'clock'
      assign paths = '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>'
    when 'package'
      assign paths = '<path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/>'
    when 'chat'
      assign paths = '<path d="M20 15.5a2 2 0 01-2 2H8l-4 3.5V6a2 2 0 012-2h12a2 2 0 012 2z"/>'
    when 'sparkle'
      assign paths = '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M18.5 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7z"/>'
    when 'droplet'
      assign paths = '<path d="M12 3.5s6.5 7 6.5 11a6.5 6.5 0 01-13 0c0-4 6.5-11 6.5-11z"/>'
    when 'bag'
      assign paths = '<path d="M5 8h14l-1 12.5H6z"/><path d="M9 10V6.5a3 3 0 016 0V10"/>'
    when 'globe'
      assign paths = '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.5 3.5 5.5 3.5 8.5s-1 6-3.5 8.5c-2.5-2.5-3.5-5.5-3.5-8.5s1-6 3.5-8.5z"/>'
    when 'award'
      assign paths = '<circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5L7 21l5-2.5 5 2.5-1.5-7.5"/>'
    when 'mail'
      assign paths = '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="M4 6.5l8 6 8-6"/>'
    else
      assign paths = ''
  endcase
-%}

{%- if paths != blank -%}
  <svg
    class="ws-icon ws-icon--{{ name }}{% if class != blank %} {{ class }}{% endif %}"
    width="{{ icon_size }}"
    height="{{ icon_size }}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {{- paths -}}
  </svg>
{%- endif -%}
