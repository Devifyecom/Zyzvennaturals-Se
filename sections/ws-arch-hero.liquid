{%- comment -%}
  WS · Arch hero — two-font headline (bold sans + gradient italic serif), intro text, pill
  button with a round arrow, optional star rating line, and a photo in an arch frame with a
  soft glow. Mobile: photo first, then text. Optional badge card on the photo (block).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'ws-ahero-h-' | append: section.id
  assign bold_font = s.bold_font
  assign italic_font = s.italic_font
  assign h_tag = s.heading_tag | default: 'h2'
  assign badge = section.blocks | where: 'type', 'badge' | first
-%}

{% render 'ws-assets' %}

<style>
  {{ bold_font | font_face: font_display: 'swap' }}
  {{ italic_font | font_face: font_display: 'swap' }}
</style>

<section
  class="ws-section ws-ahero ws-ahero--media-{{ s.image_position }}{% if s.animate %} ws-ahero--animate{% endif %}"
  style="{% render 'ws-section-style', settings: s %} --ws-ahero-bold-family: {{ bold_font.family }}, {{ bold_font.fallback_families }}; --ws-ahero-bold-weight: {{ bold_font.weight }}; --ws-ahero-italic-family: {{ italic_font.family }}, {{ italic_font.fallback_families }}; --ws-ahero-italic-weight: {{ italic_font.weight }}; --ws-ahero-italic-style: {{ italic_font.style }}; --ws-ahero-size: {{ s.heading_size }}px; --ws-ahero-size-m: {{ s.heading_size_mobile }}px; --ws-ahero-italic-scale: {{ s.italic_scale | divided_by: 100.0 }}; --ws-ahero-g1: {{ s.gradient_start }}; --ws-ahero-g2: {{ s.gradient_end }}; --ws-ahero-glow-1: {{ s.glow_color }}; --ws-ahero-glow-2: {{ s.glow_color_2 }}; --ws-ahero-body: {{ s.body_color }}; --ws-ahero-btn-bg: {{ s.button_color }}; --ws-ahero-btn-fg: {{ s.button_text_color }}; --ws-ahero-btn-edge: {{ s.button_edge_color }}; --ws-ahero-btn-glow: {{ s.button_glow_color }}; --ws-ahero-circle: {{ s.circle_color }}; --ws-ahero-arrow: {{ s.arrow_color }}; --ws-ahero-star: {{ s.star_color }}; --ws-ahero-ring: {{ s.ring_color }}; --ws-ahero-media-w: {{ s.media_width }}px; --ws-ahero-ratio: {{ s.image_ratio }}; --ws-ahero-ratio-m: {{ s.image_ratio_mobile }};"
  aria-labelledby="{{ heading_id }}"
>
  <div class="ws-container ws-ahero__grid">
    <div class="ws-ahero__text">
      <{{ h_tag }} id="{{ heading_id }}" class="ws-ahero__heading">
        {%- if s.heading_bold != blank -%}<span class="ws-ahero__bold">{{ s.heading_bold | escape }}</span>{%- endif -%}
        {%- if s.heading_bold != blank and s.heading_italic != blank %} {% endif -%}
        {%- if s.heading_italic != blank -%}<em class="ws-ahero__italic">{{ s.heading_italic | escape }}</em>{%- endif -%}
      </{{ h_tag }}>

      {%- if s.text != blank -%}
        <div class="ws-ahero__lede">{{ s.text }}</div>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <div class="ws-ahero__ctas">
          <a class="ws-ahero__btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">
            <span class="ws-ahero__btn-label">{{ s.button_label | escape }}</span>
            <span class="ws-ahero__btn-circle" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </span>
          </a>
        </div>
      {%- endif -%}

      {%- if s.rating_text != blank -%}
        <p class="ws-ahero__rating">
          <span class="ws-ahero__stars" aria-hidden="true">★★★★★</span>
          <span>{{ s.rating_text | escape }}</span>
        </p>
      {%- endif -%}
    </div>

    <div class="ws-ahero__media">
      <div class="ws-ahero__arch">
        <div class="ws-ahero__frame">
          {%- if s.image != blank -%}
            {%- liquid
              assign ws_img_alt = s.image_alt | default: s.image.alt | escape
              assign ws_pos = s.image.presentation.focal_point | default: '50% 50%'
              assign ws_pos_m = ws_pos
              if s.image_mobile != blank
                assign ws_pos_m = s.image_mobile.presentation.focal_point | default: '50% 50%'
              endif
              assign ws_img_style = '--ws-ahero-pos: ' | append: ws_pos | append: '; --ws-ahero-pos-m: ' | append: ws_pos_m | append: ';'
            -%}
            <picture>
              {%- if s.image_mobile != blank -%}
                <source
                  media="(max-width: 749px)"
                  srcset="{{ s.image_mobile | image_url: width: 480 }} 480w, {{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w"
                  sizes="90vw"
                  width="{{ s.image_mobile.width }}"
                  height="{{ s.image_mobile.height }}"
                >
              {%- endif -%}
              {{
                s.image
                | image_url: width: 1400
                | image_tag:
                  widths: '480, 640, 800, 1000, 1200, 1400',
                  sizes: '(max-width: 749px) 90vw, 579px',
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: ws_img_alt,
                  class: 'ws-ahero__img',
                  style: ws_img_style
              }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'ws-ahero__img ws-ahero__img--ph' }}
          {%- endif -%}
        </div>

        {%- if badge -%}
          {%- assign bs = badge.settings -%}
          <div class="ws-ahero__badge" {{ badge.shopify_attributes }}>
            {%- if bs.icon != blank -%}
              {{ bs.icon | image_url: width: 240 | image_tag: class: 'ws-ahero__badge-icon', loading: 'eager', alt: '' }}
            {%- endif -%}
            <div class="ws-ahero__badge-body">
              {%- if bs.text != blank -%}<div class="ws-ahero__badge-text">{{ bs.text }}</div>{%- endif -%}
              {%- if bs.link_label != blank and bs.link != blank -%}
                <a class="ws-ahero__badge-link" href="{{ bs.link }}">{{ bs.link_label | escape }}</a>
              {%- endif -%}
            </div>
            {%- if bs.closable -%}
              <button type="button" class="ws-ahero__badge-close" aria-label="{{ 'ws.a11y.close' | t }}" onclick="this.parentElement.hidden = true">
                <svg viewBox="0 0 10 10" width="8" height="8" aria-hidden="true" focusable="false"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
              </button>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .ws-ahero {
    overflow: hidden;
    background:
      radial-gradient(ellipse 70% 30% at 50% 22%, color-mix(in srgb, var(--ws-ahero-glow-1) 85%, transparent), transparent 70%),
      radial-gradient(ellipse 60% 18% at 50% 50%, color-mix(in srgb, var(--ws-ahero-glow-2) 70%, transparent), transparent 72%),
      var(--ws-bg);
  }

  @media screen and (min-width: 990px) {
    .ws-ahero {
      background:
      radial-gradient(ellipse 38% 55% at 74% 42%, color-mix(in srgb, var(--ws-ahero-glow-1) 85%, transparent), transparent 70%),
      radial-gradient(ellipse 34% 28% at 58% 100%, color-mix(in srgb, var(--ws-ahero-glow-2) 80%, transparent), transparent 72%),
      var(--ws-bg);
    }
  }

  .ws-section.ws-ahero { --ws-gutter: 20px; }

  .ws-ahero .ws-ahero__grid {
    display: flex;
    flex-direction: column;
    gap: 44px;
  }

  /* ---------- Text ---------- */
  .ws-ahero__text { order: 2; }

  .ws-ahero__heading {
    margin: 0;
    color: var(--ws-fg);
    font-family: var(--ws-ahero-bold-family);
    font-weight: var(--ws-ahero-bold-weight, 800);
    font-size: var(--ws-ahero-size-m, 41px);
    line-height: 1.02;
    letter-spacing: -0.055em;
  }

  .ws-ahero__bold { display: block; }

  .ws-ahero__italic {
    display: inline-block;
    /* room for the italic overhang + descenders so the gradient isn't clipped */
    padding: 0.02em 0.12em 0.14em 0;
    margin: -0.02em -0.12em -0.14em 0;
    font-family: var(--ws-ahero-italic-family);
    font-weight: var(--ws-ahero-italic-weight, 400);
    font-style: var(--ws-ahero-italic-style, italic);
    font-size: calc(1em * var(--ws-ahero-italic-scale, 1.32));
    line-height: 0.95;
    letter-spacing: -0.01em;
    color: var(--ws-ahero-g1);
    background-image: linear-gradient(90deg, var(--ws-ahero-g1), var(--ws-ahero-g2));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .ws-ahero__lede {
    max-width: 30em;
    margin-top: 26px;
    color: var(--ws-ahero-body);
    font-size: 18px;
    line-height: 1.55;
    letter-spacing: 0.015em;
  }

  .ws-ahero__lede p { margin: 0; }

  .ws-ahero__ctas { margin-top: 36px; }

  .ws-ahero__btn {
    display: inline-flex;
    align-items: center;
    gap: 15px;
    min-height: 54px;
    padding: 6px 7px 6px 27px;
    border-radius: 999px;
    background-color: var(--ws-ahero-btn-bg);
    color: var(--ws-ahero-btn-fg);
    font-family: var(--ws-font-body);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
    box-shadow:
      0 3px 0 var(--ws-ahero-btn-edge),
      0 16px 30px -8px var(--ws-ahero-btn-glow);
    transition: transform 0.25s var(--ws-ease), box-shadow 0.25s var(--ws-ease);
  }

  .ws-ahero__btn-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 43px;
    height: 43px;
    flex: none;
    border-radius: 50%;
    background-color: var(--ws-ahero-circle);
    color: var(--ws-ahero-arrow);
  }

  .ws-ahero__btn-circle svg {
    width: 24px;
    height: 24px;
    transition: transform 0.25s var(--ws-ease);
  }

  .ws-ahero__btn:hover {
    transform: translateY(-2px);
    box-shadow:
      0 5px 0 var(--ws-ahero-btn-edge),
      0 20px 34px -8px var(--ws-ahero-btn-glow);
  }

  .ws-ahero__btn:hover .ws-ahero__btn-circle svg { transform: translateX(3px); }

  .ws-ahero__btn:active {
    transform: translateY(2px);
    box-shadow:
      0 1px 0 var(--ws-ahero-btn-edge),
      0 10px 22px -8px var(--ws-ahero-btn-glow);
  }

  .ws-ahero__btn:focus-visible { outline: 2px solid var(--ws-fg); outline-offset: 4px; }

  .ws-ahero__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
    margin: 34px 0 0;
    color: color-mix(in srgb, var(--ws-ahero-body) 88%, var(--ws-bg));
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .ws-ahero__stars {
    color: var(--ws-ahero-star);
    font-size: 17px;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  /* ---------- Arch photo ---------- */
  .ws-ahero__media {
    order: 1;
    container-type: inline-size;
    width: calc(100% + 2 * var(--ws-gutter) - 20px);
    margin-inline: calc(10px - var(--ws-gutter));
  }

  .ws-ahero__arch {
    position: relative;
    padding: 9px;
    border-radius: 50cqi 50cqi 20px 20px;
    background-color: var(--ws-ahero-ring);
    box-shadow: 0 24px 60px -20px color-mix(in srgb, var(--ws-ahero-glow-2) 90%, transparent);
  }

  .ws-ahero__frame {
    overflow: hidden;
    border-radius: calc(50cqi - 9px) calc(50cqi - 9px) 13px 13px;
    aspect-ratio: var(--ws-ahero-ratio-m, 1);
    background-color: color-mix(in srgb, var(--ws-fg) 6%, var(--ws-bg));
  }

  .ws-ahero__frame picture { display: contents; }

  .ws-ahero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--ws-ahero-pos-m, 50% 50%);
  }

  .ws-ahero__img--ph { fill: color-mix(in srgb, var(--ws-fg) 30%, transparent); }

  /* ---------- Badge card ---------- */
  .ws-ahero__badge {
    position: absolute;
    left: 0;
    bottom: -28px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 14px;
    max-width: calc(100% - 8px);
    padding: 10px 58px 10px 12px;
    background: #fff;
    color: #1b1424;
    font-size: 13px;
    line-height: 1.4;
    box-shadow: 0 6px 18px rgb(0 0 0 / 0.08);
    clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 100%, 0 100%);
  }

  .ws-ahero__badge-icon { width: 72px; height: auto; flex: none; }
  .ws-ahero__badge-text p { margin: 0; }
  .ws-ahero__badge-link { display: inline-block; margin-top: 4px; color: inherit; font-weight: 600; text-underline-offset: 3px; }

  .ws-ahero__badge-close {
    position: absolute;
    top: 8px;
    right: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #ececec;
    color: #1b1424;
    cursor: pointer;
  }

  /* Mobile: the badge hangs below the arch, so leave room for it */
  .ws-ahero .ws-ahero__grid:has(.ws-ahero__badge:not([hidden])) { gap: 60px; }

  /* ---------- Load-in ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .ws-ahero--animate .ws-ahero__text,
    .ws-ahero--animate .ws-ahero__arch {
      animation: ws-ahero-in 0.9s var(--ws-ease) both;
    }

    .ws-ahero--animate .ws-ahero__arch { animation-delay: 0.1s; }
  }

  @keyframes ws-ahero-in {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  /* ---------- Tablet: stacked, arch centred ---------- */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .ws-ahero__media { width: min(100%, 560px); margin-inline: auto; }
    .ws-ahero__heading { font-size: calc(var(--ws-ahero-size-m, 41px) + (var(--ws-ahero-size, 79px) - var(--ws-ahero-size-m, 41px)) * 0.4); }
    .ws-ahero__badge { bottom: 0; left: 9px; max-width: calc(100% - 18px); }
    .ws-ahero .ws-ahero__grid:has(.ws-ahero__badge:not([hidden])) { gap: 44px; }
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .ws-ahero .ws-ahero__grid {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }

    .ws-ahero .ws-ahero__grid:has(.ws-ahero__badge:not([hidden])) { gap: 40px; }

    .ws-ahero--media-left .ws-ahero__grid { flex-direction: row-reverse; }

    .ws-ahero__text {
      order: 0;
      flex: 1 1 0;
      min-width: 0;
      padding-inline-start: 12px;
    }

    .ws-ahero__heading { font-size: calc(var(--ws-ahero-size-m, 41px) + (var(--ws-ahero-size, 79px) - var(--ws-ahero-size-m, 41px)) * 0.7); }

    .ws-ahero__lede { max-width: 450px; margin-top: 22px; font-size: 19px; }
    .ws-ahero__ctas { margin-top: 38px; }
    .ws-ahero__rating { column-gap: 14px; }

    .ws-ahero__media {
      order: 0;
      flex: 0 1 var(--ws-ahero-media-w, 597px);
      width: auto;
      margin-inline: 0;
    }

    .ws-ahero__frame {
      aspect-ratio: var(--ws-ahero-ratio, 0.8);
      border-radius: calc(50cqi - 9px) calc(50cqi - 9px) 13px 13px;
    }

    .ws-ahero__img { object-position: var(--ws-ahero-pos, 50% 50%); }

    .ws-ahero__badge { bottom: 0; left: 9px; max-width: calc(100% - 18px); }
  }

  @media screen and (min-width: 1200px) {
    .ws-section.ws-ahero { --ws-gutter: 64px; }
    .ws-ahero__heading { font-size: var(--ws-ahero-size, 79px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WS · Arch hero",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "heading_bold", "label": "Heading – bold line", "default": "Zyzven Naturals" },
    { "type": "text", "id": "heading_italic", "label": "Heading – gradient italic line", "default": "för ditt välmående" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag (SEO)", "default": "h2", "options": [
      { "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }
    ], "info": "Your header already outputs an H1 on the home page." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Naturliga produkter som hjälper dig att må bra – inifrån och ut, varje dag.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Handla nu" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "rating_text", "label": "Rating line", "info": "Shown next to five stars. Only use real, current numbers, e.g. \"Betyg 4,8/5 · 2 300+ kunder\". Leave empty to hide." },
    { "type": "checkbox", "id": "animate", "label": "Fade in on load", "default": true },
    { "type": "header", "content": "Photo" },
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Portrait, at least 1200 × 1500 px. Set the focal point in the image picker." },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile photo (optional)" },
    { "type": "text", "id": "image_alt", "label": "Alt text", "info": "Leave empty to use the image's own alt text." },
    { "type": "select", "id": "image_position", "label": "Photo on desktop", "default": "right", "options": [
      { "value": "right", "label": "Right" }, { "value": "left", "label": "Left" }
    ] },
    { "type": "range", "id": "media_width", "label": "Desktop arch width", "min": 400, "max": 720, "step": 1, "unit": "px", "default": 597 },
    { "type": "select", "id": "image_ratio", "label": "Desktop photo shape", "default": "0.8", "options": [
      { "value": "0.75", "label": "3:4" }, { "value": "0.8", "label": "4:5" }, { "value": "0.9", "label": "9:10" }, { "value": "1", "label": "Square" }
    ] },
    { "type": "select", "id": "image_ratio_mobile", "label": "Mobile photo shape", "default": "1", "options": [
      { "value": "0.8", "label": "4:5" }, { "value": "0.9", "label": "9:10" }, { "value": "1", "label": "Square" }, { "value": "1.2", "label": "Landscape 6:5" }
    ] },
    { "type": "header", "content": "Typography" },
    { "type": "font_picker", "id": "bold_font", "label": "Bold font", "default": "inter_n8" },
    { "type": "font_picker", "id": "italic_font", "label": "Italic font", "default": "instrument_serif_i4" },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 40, "max": 110, "step": 1, "unit": "px", "default": 79 },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 28, "max": 64, "step": 1, "unit": "px", "default": 41 },
    { "type": "range", "id": "italic_scale", "label": "Italic size (relative to bold)", "min": 100, "max": 160, "step": 2, "unit": "%", "default": 132 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFF9EC" },
    { "type": "color", "id": "glow_color", "label": "Glow behind photo", "default": "#FFDCC2" },
    { "type": "color", "id": "glow_color_2", "label": "Glow below photo", "default": "#FCC2CC" },
    { "type": "color", "id": "text_color", "label": "Heading", "default": "#1B1424" },
    { "type": "color", "id": "gradient_start", "label": "Italic gradient – start", "default": "#F782BD" },
    { "type": "color", "id": "gradient_end", "label": "Italic gradient – end", "default": "#FFBE16" },
    { "type": "color", "id": "body_color", "label": "Text", "default": "#584E60" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#FFBB14" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#1B1424" },
    { "type": "color", "id": "button_edge_color", "label": "Button bottom edge", "default": "#E3A102" },
    { "type": "color", "id": "button_glow_color", "label": "Button glow", "default": "#F499BF" },
    { "type": "color", "id": "circle_color", "label": "Arrow circle", "default": "#1B1424" },
    { "type": "color", "id": "arrow_color", "label": "Arrow", "default": "#FFBB14" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#EAA21A" },
    { "type": "color", "id": "ring_color", "label": "Arch frame", "default": "#FFEFE9" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "container_width", "label": "Content width", "default": "normal", "options": [{ "value": "narrow", "label": "Narrow" }, { "value": "normal", "label": "Normal" }, { "value": "full", "label": "Full width" }] },
    { "type": "header", "content": "Spacing – desktop" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 44 },
    { "type": "header", "content": "Spacing – mobile" },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
