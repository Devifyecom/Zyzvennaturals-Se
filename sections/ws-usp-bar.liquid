{%- liquid
  assign s = section.settings
  assign count = section.blocks.size
  if count > 4
    assign count = 4
  endif
  if count < 1
    assign count = 1
  endif
-%}

{% render 'ws-assets' %}

<section
  class="ws-section ws-usp ws-usp--{{ s.layout }} ws-usp--m-{{ s.mobile_layout }}{% if s.dividers %} ws-usp--dividers{% endif %}"
  style="{% render 'ws-section-style', settings: s %} --ws-usp-cols: {{ count }}; --ws-usp-icon: {{ s.icon_size }}px;"
  aria-label="{{ s.aria_label | escape }}"
>
  <div class="ws-container">
    <ul class="ws-usp__list" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="ws-usp__item" {{ block.shopify_attributes }}>
          {%- if b.custom_icon != blank -%}
            <span class="ws-usp__icon">{{ b.custom_icon | image_url: width: 120 | image_tag: width: s.icon_size, height: s.icon_size, loading: 'lazy', alt: '' }}</span>
          {%- elsif b.icon != 'none' -%}
            <span class="ws-usp__icon">{% render 'ws-icon', name: b.icon, size: s.icon_size %}</span>
          {%- endif -%}
          <div class="ws-usp__text">
            {%- if b.title != blank -%}<p class="ws-usp__title">{{ b.title }}</p>{%- endif -%}
            {%- if b.text != blank -%}<div class="ws-usp__body ws-muted">{{ b.text }}</div>{%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .ws-usp__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ws-usp--m-stack .ws-usp__list { grid-template-columns: minmax(0, 1fr); }

  .ws-usp--m-scroll .ws-usp__list {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: 70%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(var(--ws-gutter) * -1);
    padding-inline: var(--ws-gutter);
  }

  .ws-usp--m-scroll .ws-usp__item { scroll-snap-align: start; }

  .ws-usp__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-align: center;
  }

  .ws-usp--inline .ws-usp__item {
    flex-direction: row;
    align-items: flex-start;
    text-align: left;
  }

  .ws-usp__icon { display: inline-flex; flex: none; }
  .ws-usp__icon img { width: var(--ws-usp-icon); height: var(--ws-usp-icon); object-fit: contain; }

  .ws-usp__title {
    margin: 0 0 4px;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ws-usp__body { font-size: 13px; line-height: 1.5; }
  .ws-usp__body p { margin: 0; }

  @media screen and (min-width: 750px) {
    .ws-usp .ws-usp__list,
    .ws-usp--m-stack .ws-usp__list,
    .ws-usp--m-scroll .ws-usp__list {
      grid-auto-flow: row;
      grid-template-columns: repeat(var(--ws-usp-cols, 4), minmax(0, 1fr));
      gap: 32px;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
    }

    .ws-usp--dividers .ws-usp__item + .ws-usp__item {
      border-left: 1px solid var(--ws-border);
      padding-left: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WS · USP bar",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessible name", "default": "Därför handlar du hos oss" },
    { "type": "select", "id": "layout", "label": "Item layout", "default": "stacked", "options": [
      { "value": "stacked", "label": "Icon above text" }, { "value": "inline", "label": "Icon beside text" }
    ] },
    { "type": "select", "id": "mobile_layout", "label": "Mobile layout", "default": "grid", "options": [
      { "value": "grid", "label": "2-column grid" }, { "value": "stack", "label": "1 column" }, { "value": "scroll", "label": "Swipe row" }
    ] },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 16, "max": 48, "step": 2, "unit": "px", "default": 26 },
    { "type": "checkbox", "id": "dividers", "label": "Show dividers on desktop", "default": false },
    {"type": "header", "content": "Colours"},
    {"type": "color", "id": "background_color", "label": "Background", "default": "#ECE8E0"},
    {"type": "color", "id": "text_color", "label": "Text", "default": "#111111"},
    {"type": "color", "id": "accent_color", "label": "Button background", "default": "#000000"},
    {"type": "color", "id": "accent_text_color", "label": "Button text", "default": "#FFFFFF"},
    {"type": "header", "content": "Layout"},
    {"type": "select", "id": "container_width", "label": "Content width", "default": "normal", "options": [{"value": "narrow", "label": "Narrow"}, {"value": "normal", "label": "Normal"}, {"value": "full", "label": "Full width"}]},
    {"type": "header", "content": "Spacing – desktop"},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40},
    {"type": "header", "content": "Spacing – mobile"},
    {"type": "range", "id": "padding_top_mobile", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32},
    {"type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 32}
  ],
  "blocks": [
    {
      "type": "usp",
      "name": "USP",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "truck", "options": [
          { "value": "none", "label": "None" }, { "value": "truck", "label": "Truck" }, { "value": "package", "label": "Package" },
          { "value": "return", "label": "Returns" }, { "value": "lock", "label": "Lock" }, { "value": "shield", "label": "Shield" },
          { "value": "leaf", "label": "Leaf" }, { "value": "heart", "label": "Heart" }, { "value": "gift", "label": "Gift" },
          { "value": "clock", "label": "Clock" }, { "value": "chat", "label": "Chat" }, { "value": "award", "label": "Award" },
          { "value": "sparkle", "label": "Sparkle" }, { "value": "droplet", "label": "Droplet" }, { "value": "globe", "label": "Globe" },
          { "value": "star", "label": "Star" }, { "value": "check", "label": "Check" }
        ] },
        { "type": "image_picker", "id": "custom_icon", "label": "Custom icon image", "info": "Overrides the icon above." },
        { "type": "inline_richtext", "id": "title", "label": "Title", "default": "Fri frakt" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>På beställningar över 499 kr</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "WS · USP bar",
      "blocks": [
        { "type": "usp", "settings": { "icon": "truck", "title": "Fri frakt", "text": "<p>På beställningar över 499 kr</p>" } },
        { "type": "usp", "settings": { "icon": "clock", "title": "Snabb leverans", "text": "<p>Leverans inom 1–3 vardagar</p>" } },
        { "type": "usp", "settings": { "icon": "return", "title": "Enkla returer", "text": "<p>30 dagars öppet köp</p>" } },
        { "type": "usp", "settings": { "icon": "lock", "title": "Säker betalning", "text": "<p>Klarna, kort & Swish</p>" } }
      ]
    }
  ]
}
{% endschema %}
