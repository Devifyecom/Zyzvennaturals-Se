{%- comment -%}
  WS · Testimonial cards — swipeable row of bordered cards (photo + stars + quote + name +
  "verified" line) with pagination dots. Desktop: photo left, ~2¼ cards visible. Mobile: photo on
  top, one card with the next one peeking in. Brand fonts and colours by default.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'ws-tc-h-' | append: section.id

  case s.heading_font
    when 'body'
      assign heading_family = 'var(--font-body--family)'
      assign heading_weight = '700'
    when 'subheading'
      assign heading_family = 'var(--font-subheading--family)'
      assign heading_weight = 'var(--font-subheading--weight, 400)'
    when 'accent'
      assign heading_family = 'var(--font-accent--family)'
      assign heading_weight = 'var(--font-accent--weight, 400)'
    else
      assign heading_family = 'var(--font-heading--family)'
      assign heading_weight = 'var(--font-heading--weight, 400)'
  endcase

  assign card_count = 0
  for block in section.blocks
    if block.settings.quote != blank or block.settings.image != blank or block.settings.author != blank or request.design_mode
      assign card_count = card_count | plus: 1
    endif
  endfor
-%}

{%- if card_count > 0 -%}
  {% render 'ws-assets' %}

  <section
    class="ws-section ws-tc{% if s.uppercase_heading %} ws-tc--upper{% endif %}"
    style="{% render 'ws-section-style', settings: s %} --ws-tc-bg-2: {{ s.background_color_2 }}; --ws-tc-heading-family: {{ heading_family }}; --ws-tc-heading-weight: {{ heading_weight }}; --ws-tc-heading-size: {{ s.heading_size }}px; --ws-tc-heading-size-m: {{ s.heading_size_mobile }}px; --ws-tc-card-bg: {{ s.card_color }}; --ws-tc-border: {{ s.border_color }}; --ws-tc-border-w: {{ s.border_width }}px; --ws-tc-radius: {{ s.card_radius }}px; --ws-tc-star: {{ s.star_color }}; --ws-tc-star-off: {{ s.star_empty_color }}; --ws-tc-quote: {{ s.quote_color }}; --ws-tc-verified: {{ s.verified_color }}; --ws-tc-check: {{ s.check_color }}; --ws-tc-dot: {{ s.dot_color }}; --ws-tc-dot-active: {{ s.dot_active_color }}; --ws-tc-photo-w: {{ s.photo_width }}%; --ws-tc-per-view: {{ s.cards_per_view | divided_by: 100.0 }};{% if s.container_width == 'normal' %} --ws-max-width: calc(1197px + 2 * var(--ws-gutter));{% endif %}"
    {% if s.heading != blank %}aria-labelledby="{{ heading_id }}"{% else %}aria-label="{{ 'ws.a11y.testimonials' | t }}"{% endif %}
  >
    <div class="ws-container">
      {%- if s.heading != blank -%}
        <h2 id="{{ heading_id }}" class="ws-tc__heading">{{ s.heading | escape }}</h2>
      {%- endif -%}

      <ws-testimonials class="ws-tc__carousel">
        <ul class="ws-tc__track" data-ws-track tabindex="0" role="list" aria-label="{{ 'ws.a11y.testimonials' | t }}">
          {%- for block in section.blocks -%}
            {%- assign b = block.settings -%}
            {%- if b.quote == blank and b.image == blank and b.author == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
            {%- assign rating = b.rating | plus: 0 -%}
            <li class="ws-tc__card{% if b.image == blank and request.design_mode == false %} ws-tc__card--no-photo{% endif %}" data-ws-card {{ block.shopify_attributes }}>
              {%- if b.image != blank -%}
                <div class="ws-tc__photo">
                  {%- assign ws_img_alt = b.image.alt | default: b.author | escape -%}
                  {{
                    b.image
                    | image_url: width: 900
                    | image_tag:
                      widths: '300, 450, 600, 750, 900',
                      sizes: '(max-width: 749px) 80vw, 220px',
                      loading: 'lazy',
                      alt: ws_img_alt,
                      class: 'ws-tc__img'
                  }}
                </div>
              {%- elsif request.design_mode -%}
                <div class="ws-tc__photo">
                  {%- assign ph = forloop.index0 | modulo: 2 | plus: 1 -%}
                  {{ 'lifestyle-' | append: ph | placeholder_svg_tag: 'ws-tc__img ws-tc__img--ph' }}
                </div>
              {%- endif -%}

              <div class="ws-tc__body">
                {%- if rating > 0 -%}
                  <div class="ws-tc__stars" role="img" aria-label="{{ 'ws.a11y.star_rating' | t: rating: rating }}">
                    {%- for i in (1..5) -%}
                      <span class="ws-tc__star{% if i > rating %} is-off{% endif %}" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="12" height="12" focusable="false"><path d="M12 2.8l2.7 5.9 6.4.7-4.8 4.4 1.3 6.4L12 17l-5.6 3.2 1.3-6.4-4.8-4.4 6.4-.7z" fill="currentColor"/></svg>
                      </span>
                    {%- endfor -%}
                  </div>
                {%- endif -%}

                {%- if b.quote != blank -%}
                  <blockquote class="ws-tc__quote">{{ b.quote }}</blockquote>
                {%- elsif request.design_mode -%}
                  <blockquote class="ws-tc__quote ws-muted">{{ 'ws.a11y.testimonials' | t }}</blockquote>
                {%- endif -%}

                {%- if b.author != blank -%}
                  <p class="ws-tc__author">{{ b.author | escape }}</p>
                {%- endif -%}

                {%- if b.verified and s.verified_label != blank -%}
                  <p class="ws-tc__verified">
                    <span class="ws-tc__check" aria-hidden="true">
                      <svg viewBox="0 0 24 24" width="11" height="11" focusable="false"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span>{{ s.verified_label | escape }}</span>
                  </p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if card_count > 1 -%}
          <div class="ws-tc__dots" data-ws-dots>
            {%- for i in (1..card_count) -%}
              <button type="button" class="ws-tc__dot" aria-label="{{ 'ws.a11y.go_to_testimonial' | t: index: i }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </ws-testimonials>
    </div>
  </section>
  <script src="{{ 'ws-testimonials.js' | asset_url }}" type="module" defer></script>
{%- endif -%}

{% stylesheet %}
  .ws-tc {
    background: linear-gradient(180deg, var(--ws-bg), var(--ws-tc-bg-2, var(--ws-bg)));
  }

  .ws-tc__heading {
    max-width: 70rem;
    margin: 0 auto 28px;
    text-align: center;
    color: var(--ws-fg);
    font-family: var(--ws-tc-heading-family);
    font-weight: var(--ws-tc-heading-weight, 400);
    font-size: var(--ws-tc-heading-size-m, 24px);
    line-height: 1.18;
    letter-spacing: 0.01em;
    text-wrap: balance;
  }

  .ws-tc--upper .ws-tc__heading { text-transform: uppercase; letter-spacing: 0.02em; }

  .ws-tc__carousel { display: block; }

  .ws-tc__track {
    display: flex;
    gap: 14px;
    margin: 0 calc(-1 * var(--ws-gutter));
    padding: 0 var(--ws-gutter) 2px;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--ws-gutter);
    scrollbar-width: none;
    cursor: grab;
  }

  .ws-tc__track::-webkit-scrollbar { display: none; }
  .ws-tc__track.is-dragging { cursor: grabbing; scroll-snap-type: none; user-select: none; }
  .ws-tc__track:focus-visible { outline: 2px solid var(--ws-fg); outline-offset: 4px; }

  .ws-tc__card {
    display: flex;
    flex-direction: column;
    flex: 0 0 80%;
    overflow: hidden;
    scroll-snap-align: start;
    border: var(--ws-tc-border-w, 2px) solid var(--ws-tc-border);
    border-radius: var(--ws-tc-radius, 8px);
    background-color: var(--ws-tc-card-bg);
  }

  .ws-tc__photo {
    flex: none;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--ws-fg) 6%, var(--ws-tc-card-bg));
  }

  .ws-tc__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-user-drag: none;
    user-select: none;
  }

  .ws-tc__img--ph { fill: color-mix(in srgb, var(--ws-fg) 30%, transparent); }

  .ws-tc__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 18px 15px 18px;
    font-family: var(--font-body--family);
  }

  .ws-tc__stars { display: flex; gap: 2px; margin-bottom: 14px; }

  .ws-tc__star {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    background-color: var(--ws-tc-star);
    color: #fff;
  }

  .ws-tc__star.is-off { background-color: var(--ws-tc-star-off); }

  .ws-tc__quote {
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--ws-tc-quote);
    font-size: 16px;
    font-style: normal;
    line-height: 1.42;
    letter-spacing: 0.005em;
  }

  .ws-tc__quote p { margin: 0; }

  .ws-tc__author {
    margin: 16px 0 0;
    color: var(--ws-fg);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ws-tc__verified {
    display: flex;
    align-items: center;
    gap: 9px;
    margin: 12px 0 0;
    color: var(--ws-tc-verified);
    font-size: 15px;
    line-height: 1.3;
  }

  .ws-tc__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    flex: none;
    border-radius: 50%;
    background-color: var(--ws-tc-check);
    color: #fff;
  }

  .ws-tc__dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 22px;
  }

  .ws-tc__dot {
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--ws-tc-dot);
    cursor: pointer;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .ws-tc__dot:hover { transform: scale(1.15); }
  .ws-tc__dot[aria-current='true'] { background-color: var(--ws-tc-dot-active); }
  .ws-tc__dot:focus-visible { outline: 2px solid var(--ws-fg); outline-offset: 3px; }

  @media screen and (min-width: 750px) {
    .ws-tc__heading { font-size: calc((var(--ws-tc-heading-size-m, 24px) + var(--ws-tc-heading-size, 33px)) / 2); margin-bottom: 34px; }
    .ws-tc__card { flex-basis: calc((100% - 14px) / 1.6); }
  }

  @media screen and (min-width: 990px) {
    .ws-tc__heading { font-size: var(--ws-tc-heading-size, 33px); margin-bottom: 38px; }

    /* Desktop: cards are clipped at the content edge, like the reference */
    .ws-tc__track { gap: 16px; margin: 0; padding: 0 0 2px; scroll-padding-inline: 0; }

    .ws-tc__card {
      flex-direction: row;
      flex-basis: calc((100% - 32px) / var(--ws-tc-per-view, 2.18));
    }

    .ws-tc__photo { width: var(--ws-tc-photo-w, 40%); aspect-ratio: auto; }
    .ws-tc__img { position: relative; }

    .ws-tc__body { padding: 22px 20px 20px 22px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "WS · Testimonial cards",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Se varför våra kunder gör Zyzven Naturals till en del av vardagen" },
    { "type": "checkbox", "id": "uppercase_heading", "label": "Uppercase heading", "default": true },
    { "type": "select", "id": "heading_font", "label": "Heading font", "default": "heading", "options": [
      { "value": "heading", "label": "Theme heading font" }, { "value": "subheading", "label": "Theme subheading font" },
      { "value": "body", "label": "Theme body font" }, { "value": "accent", "label": "Theme accent font" }
    ], "info": "Fonts come from Theme settings › Typography." },
    { "type": "range", "id": "heading_size", "label": "Desktop heading size", "min": 20, "max": 56, "step": 1, "unit": "px", "default": 33 },
    { "type": "range", "id": "heading_size_mobile", "label": "Mobile heading size", "min": 16, "max": 40, "step": 1, "unit": "px", "default": 24 },
    { "type": "text", "id": "verified_label", "label": "Verified label", "default": "Verifierad köpare", "info": "Shown on cards where \"Verified buyer\" is ticked." },
    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "cards_per_view", "label": "Cards visible on desktop", "min": 150, "max": 350, "step": 2, "unit": "%", "default": 218, "info": "218% = two cards with the third peeking in." },
    { "type": "range", "id": "photo_width", "label": "Desktop photo width", "min": 30, "max": 55, "step": 1, "unit": "%", "default": 40 },
    { "type": "range", "id": "card_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 8 },
    { "type": "range", "id": "border_width", "label": "Border width", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 2 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "background_color", "label": "Background (top)", "default": "#FFFFFF" },
    { "type": "color", "id": "background_color_2", "label": "Background (bottom)", "default": "#F4F1EC" },
    { "type": "color", "id": "text_color", "label": "Heading and name", "default": "#000000" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#FFFFFF" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#000000" },
    { "type": "color", "id": "quote_color", "label": "Quote text", "default": "#333333" },
    { "type": "color", "id": "star_color", "label": "Stars", "default": "#7B8C78" },
    { "type": "color", "id": "star_empty_color", "label": "Empty stars", "default": "#DFDFDF" },
    { "type": "color", "id": "check_color", "label": "Verified tick", "default": "#7B8C78" },
    { "type": "color", "id": "verified_color", "label": "Verified text", "default": "#4A4A4A" },
    { "type": "color", "id": "dot_color", "label": "Dots", "default": "#DFDFDF" },
    { "type": "color", "id": "dot_active_color", "label": "Active dot", "default": "#000000" },
    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "container_width", "label": "Content width", "default": "normal", "options": [{ "value": "narrow", "label": "Narrow" }, { "value": "normal", "label": "Normal" }, { "value": "full", "label": "Full width" }] },
    { "type": "header", "content": "Spacing – desktop" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "header", "content": "Spacing – mobile" },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 28 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo", "info": "Square or portrait. Only use photos you have permission to publish." },
        { "type": "range", "id": "rating", "label": "Stars", "min": 0, "max": 5, "step": 1, "default": 5, "info": "0 hides the stars." },
        { "type": "richtext", "id": "quote", "label": "Quote", "info": "Use real customer reviews only. A card shows on the store once it has a photo, quote or name." },
        { "type": "text", "id": "author", "label": "Customer name", "info": "E.g. first name and initial: \"Anna K.\"" },
        { "type": "checkbox", "id": "verified", "label": "Verified buyer", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "WS · Testimonial cards",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
