      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Text</p>" },
        { "type": "select", "id": "style", "label": "Style", "default": "body", "options": [
          { "value": "body", "label": "Body" }, { "value": "small", "label": "Small" }, { "value": "muted", "label": "Small muted" }
        ] }
      ]
    },
    { "type": "custom_liquid", "name": "Custom Liquid", "settings": [ { "type": "liquid", "id": "custom_liquid", "label": "Liquid" } ] }
  ]
}
{% endschema %}
