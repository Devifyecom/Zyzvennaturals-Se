<div class="hero-slider-section">
  <h2 class="hero-slider-heading">{{ section.settings.section_heading }}</h2>

  <div class="hero-slider"
       data-flickity='{
         "cellAlign": "left",
         "contain": true,
         "wrapAround": true,
         "autoPlay": 3000,
         "prevNextButtons": true,
         "pageDots": false,
         "dragThreshold": 5
       }'>

    {% for block in section.blocks %}
      <div class="hero-slide" style="background-image:url({{ block.settings.slide_image | img_url: '1500x' }});">

        {% if block.settings.slide_link != blank %}
        <a href="{{ block.settings.slide_link }}" class="hero-slide-link"></a>
        {% endif %}

        <div class="hero-slide-content">
          {% if block.settings.button_text %}
            <a href="{{ block.settings.button_link }}" class="hero-slide-btn">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>

      </div>
    {% endfor %}
  </div>
</div>

<style>

.hero-slider-section {
    max-width: 94%;
    margin-left: auto;
    padding: 60px 0px 60px 0px;
}

.hero-slider-heading {
  color: black;
  text-align: center;
  font-size: 30px;
  margin-bottom: 30px;
  font-weight: 700;
}

.hero-slider .hero-slide {
     background: #f3f0e6;
  width: calc(28% - 12px); /* makes 2.7 visible */
  margin-right: 12px;
  height: 400px;
  border-radius: 18px;
  background-size: cover;
  background-position: center;
  position: relative;
  overflow: hidden;
}

.hero-slide-link {
   
  position: absolute;
  inset: 0;
  z-index: 1;
}

.hero-slide-content {
  position: absolute;
  bottom: 30px;
  left: 36%;
  z-index: 2;
}

.hero-slide-btn {
    font-size: 12px;
    height: 36px;
  color: #8c7050;
  background: #fff;
  padding: 12px 22px;
  border-radius: 50px;
  font-weight: 600;
  text-decoration: none;
   box-shadow: 0 6px 18px rgba(0,0,0,0.15);
}
.hero-slide-btn:hover {
    font-size: 12px;
    height: 36px;
  color: #fff;
  background: #8c7050;
  padding: 12px 22px;
  border-radius: 50px;
  font-weight: 600;
  text-decoration: none;
   box-shadow: 0 6px 18px rgba(0,0,0,0.15);
}
.flickity-prev-next-button .flickity-button-icon {
    position: absolute;
    left: 23%;
    top: 25%;
    width: 47%;
    height: 47%;
}
.flickity-prev-next-button {
    top: 50%;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    transform: translateY(-50%);
}
@media(max-width: 767px) {
  .hero-slider .hero-slide {
    width: calc(76% - 12px); /* 1.3 visible */
    height: 300px;
  }
}
</style>

{% schema %}
{
  "name": "Dynamic Hero Slider",
  "settings": [
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "Solutions for Every Skin Needs"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "slide_image",
          "label": "Background Image"
        },
        {
          "type": "url",
          "id": "slide_link",
          "label": "Slide Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Handla Nu"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero Slider"
    }
  ]
}
{% endschema %}
